# Example environment variables for Convergence_Engine
# Copy this file to .env and fill in secrets locally (do NOT commit .env)

# Ollama (optional): API key and base URL for Ollama Cloud or local server
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Database: Postgres
POSTGRES_PASSWORD=
DJINN_DB_USERNAME=
DJINN_DB_PASSWORD=

# Internal/External API keys
INTERNAL_API_KEY=
EXTERNAL_API_KEY=

# Other optional secrets
DJINN_DEFAULT_PASSWORD=
